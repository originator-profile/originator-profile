{
  "name": "@originator-profile/originator-profile",
  "description": "Originator Profile Web Extension",
  "version": "0.5.0-beta.0",
  "license": "Apache-2.0",
  "private": true,
  "homepage": "https://docs.originator-profile.org",
  "repository": "https://github.com/originator-profile/originator-profile",
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "version": "node --run=build && git add packages/*/README.md",
    "dev": "turbo run dev --parallel --env-mode=loose",
    "e2e": "turbo run e2e --concurrency=1 --filter=!@originator-profile/wordpress",
    "e2e:update": "turbo run e2e:update --concurrency=1 --filter=!@originator-profile/wordpress",
    "test": "turbo run test --continue",
    "lint": "turbo run lint --continue",
    "type-check": "turbo run type-check --continue",
    "format": "prettier --write .",
    "update": "run-s update:save update:pnpm update:dedupe update:changelog",
    "update:save": "node scripts/generate-update-changelog.mjs save",
    "update:pnpm": "pnpm --recursive update --latest",
    "update:dedupe": "pnpm dedupe",
    "update:changelog": "node scripts/generate-update-changelog.mjs generate",
    "docs": "run-s docs:ts docs:build",
    "docs:ts": "typedoc",
    "docs:build": "astro build",
    "docs:preview": "astro preview"
  },
  "devDependencies": {
    "@lerna-lite/cli": "^4.11.0",
    "@lerna-lite/version": "^4.11.1",
    "@types/jsdom": "^27.0.0",
    "astro": "^5.17.0",
    "npm-run-all2": "^8.0.4",
    "prettier": "^3.8.1",
    "prettier-plugin-organize-imports": "^4.3.0",
    "turbo": "2.8.0",
    "typedoc": "^0.28.16"
  },
  "engines": {
    "node": "^20.18.0 || ^22.2.0 || ^24.10.0"
  },
  "packageManager": "pnpm@10.24.0+sha512.01ff8ae71b4419903b65c60fb2dc9d34cf8bb6e06d03bde112ef38f7a34d6904c424ba66bea5cdcf12890230bf39f9580473140ed9c946fef328b6e5238a345a"
}
