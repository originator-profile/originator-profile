{
  "name": "@originator-profile/originator-profile",
  "description": "Originator Profile Web Extension",
  "version": "0.6.0-beta.0",
  "license": "Apache-2.0",
  "private": true,
  "homepage": "https://docs.originator-profile.org",
  "repository": "https://github.com/originator-profile/originator-profile",
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "version": "node --run=build && git add packages/*/README.md",
    "dev": "turbo run dev --parallel --env-mode=loose",
    "e2e": "turbo run e2e --concurrency=1 --filter=!@originator-profile/wordpress",
    "e2e:update": "turbo run e2e:update --concurrency=1 --filter=!@originator-profile/wordpress",
    "test": "turbo run test --continue",
    "lint": "turbo run lint --continue",
    "type-check": "turbo run type-check --continue",
    "format": "prettier --write .",
    "update": "run-s update:pnpm update:dedupe",
    "update:pnpm": "pnpm --recursive update --latest",
    "update:dedupe": "pnpm dedupe",
    "docs": "run-s docs:ts docs:build",
    "docs:ts": "typedoc",
    "docs:build": "astro build",
    "docs:preview": "astro preview"
  },
  "devDependencies": {
    "@lerna-lite/cli": "^4.11.5",
    "@lerna-lite/version": "^4.11.5",
    "@types/jsdom": "^28.0.1",
    "astro": "^6.1.3",
    "npm-run-all2": "^8.0.4",
    "prettier": "^3.8.1",
    "prettier-plugin-organize-imports": "^4.3.0",
    "turbo": "2.9.3",
    "typedoc": "^0.28.18"
  },
  "engines": {
    "node": "^22.2.0 || ^24.10.0"
  },
  "packageManager": "pnpm@10.33.0+sha512.10568bb4a6afb58c9eb3630da90cc9516417abebd3fabbe6739f0ae795728da1491e9db5a544c76ad8eb7570f5c4bb3d6c637b2cb41bfdcdb47fa823c8649319"
}
