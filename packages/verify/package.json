{
  "name": "@originator-profile/verify",
  "version": "0.5.0-beta.1",
  "license": "Apache-2.0",
  "homepage": "https://docs.originator-profile.org",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/originator-profile/originator-profile.git",
    "directory": "packages/verify"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "exports": {
    "require": {
      "types": "./dist/index.d.cts",
      "default": "./dist/index.cjs"
    },
    "import": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "pkgroll --clean-dist --target=node20",
    "test": "vitest run",
    "e2e": "playwright test",
    "e2e:update": "playwright test --update-snapshots",
    "lint": "eslint --fix .",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@originator-profile/core": "workspace:*",
    "@originator-profile/cryptography": "workspace:*",
    "@originator-profile/model": "workspace:*",
    "@originator-profile/securing-mechanism": "workspace:*",
    "@originator-profile/sign": "workspace:*",
    "@types/jsonld": "^1.5.15",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "jose": "^6.0.10",
    "jsonld": "^9.0.0"
  },
  "devDependencies": {
    "@originator-profile/tsconfig": "workspace:*",
    "@playwright/test": "^1.57.0",
    "date-fns": "^4.1.0",
    "eslint": "^9.25.1",
    "eslint-config-originator-profile": "workspace:*",
    "happy-dom": "^20.0.0",
    "just-diff-apply": "^5.5.0",
    "just-typeof": "^3.2.0",
    "pkgroll": "^2.12.2",
    "playwright": "^1.57.0",
    "typescript": "^5.8.3",
    "urlpattern-polyfill": "^10.0.0",
    "vite": "^7.0.0",
    "vitest": "^4.0.0",
    "websri": "^1.0.1"
  }
}
