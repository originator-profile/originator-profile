  "license": "Apache-2.0",
  "private": true,
  "homepage": "https://docs.originator-profile.org",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/originator-profile/originator-profile.git",
    "directory": "packages/extension-common"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "default": "./src/index.ts"
    },
