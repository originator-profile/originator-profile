{
  "name": "@originator-profile/opvc",
  "version": "0.6.0-beta.1",
  "license": "Apache-2.0",
  "homepage": "https://docs.originator-profile.org",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/originator-profile/originator-profile.git",
    "directory": "packages/opvc"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "files": [
    "bin",
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "bin": "bin/run.js",
  "exports": {
    "types": "./dist/index.d.ts",
    "default": "./dist/index.js"
  },
  "oclif": {
    "bin": "opvc",
    "commands": "dist/commands",
    "helpClass": "./dist/help",
    "repositoryPrefix": "<%- repo %>/blob/v<%- version %>/packages/opvc/<%- commandPath %>",
    "plugins": [
      "@oclif/plugin-help"
    ]
  },
  "scripts": {
    "build": "tsdown && oclif manifest && oclif readme",
    "lint": "eslint --fix .",
    "type-check": "tsc",
    "test": "node --test"
  },
  "dependencies": {
    "@oclif/core": "^4.10.3",
    "@oclif/plugin-help": "^6.2.41",
    "@originator-profile/core": "workspace:*",
    "@originator-profile/cryptography": "workspace:*",
    "@originator-profile/model": "workspace:*",
    "@originator-profile/securing-mechanism": "workspace:*",
    "@originator-profile/sign": "workspace:*",
    "date-fns": "^4.1.0",
    "http-errors-enhanced": "^4.0.2",
    "jose": "^6.2.2",
    "jsdom": "^29.0.1",
    "wrap-ansi": "^9.0.2"
  },
  "devDependencies": {
    "@originator-profile/tsconfig": "workspace:*",
    "@types/node": "25.6.0",
    "eslint": "10.2.0",
    "eslint-config-originator-profile": "workspace:*",
    "oclif": "4.23.0",
    "tsdown": "0.21.7",
    "typescript": "6.0.2",
    "websri": "1.0.1"
  }
}
