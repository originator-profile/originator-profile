{
  "name": "@originator-profile/sign",
  "version": "0.5.0-beta.3",
  "license": "Apache-2.0",
  "homepage": "https://docs.originator-profile.org",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/originator-profile/originator-profile.git",
    "directory": "packages/sign"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "exports": {
    "require": {
      "types": "./dist/index.d.cts",
      "default": "./dist/index.cjs"
    },
    "import": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "pkgroll --clean-dist --target=node20",
    "test": "vitest run",
    "lint": "eslint --fix .",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@originator-profile/cryptography": "workspace:*",
    "@originator-profile/model": "workspace:*",
    "@originator-profile/securing-mechanism": "workspace:*",
    "jose": "^6.0.10"
  },
  "devDependencies": {
    "@originator-profile/tsconfig": "workspace:*",
    "date-fns": "^4.1.0",
    "eslint": "^9.25.1",
    "eslint-config-originator-profile": "workspace:*",
    "pkgroll": "^2.12.2",
    "typescript": "^5.8.3",
    "vitest": "^4.0.0",
    "websri": "^1.0.1"
  }
}
