{
  "name": "@originator-profile/vite-plugin",
  "version": "0.6.0-beta.0",
  "license": "Apache-2.0",
  "homepage": "https://docs.originator-profile.org",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/originator-profile/originator-profile.git",
    "directory": "packages/vite-plugin"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "exports": {
    "require": {
      "types": "./dist/index.d.cts",
      "default": "./dist/index.cjs"
    },
    "import": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "pkgroll --clean-dist --target=node20",
    "test": "vitest run",
    "e2e": "playwright test",
    "e2e:update": "playwright test --update-snapshots",
    "lint": "eslint --fix .",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@originator-profile/core": "workspace:*",
    "@originator-profile/cryptography": "workspace:*",
    "@originator-profile/model": "workspace:*",
    "@originator-profile/opvc": "workspace:*",
    "@originator-profile/securing-mechanism": "workspace:*",
    "@originator-profile/sign": "workspace:*"
  },
  "peerDependencies": {
    "vite": "^6.0.0 || ^7.0.0 || ^8.0.0"
  },
  "devDependencies": {
    "@originator-profile/tsconfig": "workspace:*",
    "@playwright/test": "^1.59.1",
    "date-fns": "^4.1.0",
    "eslint": "^10.1.0",
    "eslint-config-originator-profile": "workspace:*",
    "happy-dom": "^20.8.9",
    "pkgroll": "^2.27.0",
    "playwright": "^1.59.1",
    "typescript": "^6.0.2",
    "vite": "^8.0.3",
    "vitest": "^4.1.2",
    "websri": "^1.0.1"
  }
}
