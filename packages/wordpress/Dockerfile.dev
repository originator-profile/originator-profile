FROM wordpress:7.1.3-php8.2@sha256:841fdef84001500e47ccc605a9429ecd0dc3df83735636645d2ba0563679998d

# Install composer
RUN php -r "copy('https://getcomposer.org/installer', 'composer-setup.php');" \
    && php composer-setup.php --install-dir=/usr/local/bin --filename=composer \
    && php -r "unlink('composer-setup.php');"

ENV SHELL=/bin/bash
ENV PATH=/var/www/html/wp-content/plugins/ca-manager/vendor/bin:${PATH}
