{
  "scripts": {
    "help": "cat README.md",
    "test": "phpunit",
    "test:integration:bulk": "wp --path=/var/www/html eval-file /var/www/html/wp-content/plugins/ca-manager/tests/integration/bulk.php",
    "test:integration:exclusion": "wp --path=/var/www/html eval-file /var/www/html/wp-content/plugins/ca-manager/tests/integration/exclusion.php",
    "test:integration:storage": "wp --path=/var/www/html eval-file /var/www/html/wp-content/plugins/ca-manager/tests/integration/issue-storage.php",
    "test:integration": [
      "@test:integration:bulk",
      "@test:integration:exclusion",
      "@test:integration:storage"
    ],
    "lint": "phpcs .",
    "format": "phpcbf -v ."
  },
  "require": {
    "jumbojett/openid-connect-php": "^1.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.0",
    "wp-cli/wp-cli-bundle": "^2.11",
    "wp-coding-standards/wpcs": "^3.1"
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    }
  }
}
