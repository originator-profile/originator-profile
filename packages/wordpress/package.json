{
  "name": "@originator-profile/wordpress",
  "version": "0.7.0-beta.5",
  "license": "Apache-2.0",
  "private": true,
  "homepage": "https://docs.originator-profile.org",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/originator-profile/originator-profile.git",
    "directory": "packages/wordpress"
  },
  "type": "module",
  "scripts": {
    "lint": "oxlint assets/*.js e2e/*.ts playwright.config.ts",
    "lint:fix": "oxlint --fix assets/*.js e2e/*.ts playwright.config.ts",
    "format": "oxfmt --write assets/*.js assets/*.css e2e/*.ts playwright.config.ts",
    "format:check": "oxfmt --check assets/*.js assets/*.css e2e/*.ts playwright.config.ts",
    "e2e": "playwright test",
    "e2e:update": "playwright test --update-snapshots",
    "version": "shx sed -i 's/(?<= Version: *)[^ ]*$/'${npm_package_version}/ ca-manager.php && git add ca-manager.php"
  },
  "devDependencies": {
    "@playwright/test": "1.59.1",
    "@types/node": "25.6.0",
    "@wordpress/e2e-test-utils-playwright": "1.45.0",
    "oxfmt": "0.68.0",
    "oxlint": "^1.73.0",
    "oxlint-tsgolint": "^0.24.0",
    "shx": "0.4.0"
  }
}
