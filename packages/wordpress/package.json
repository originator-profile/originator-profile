{
  "name": "@originator-profile/wordpress",
  "version": "0.7.0-beta.5",
  "license": "Apache-2.0",
  "private": true,
  "homepage": "https://docs.originator-profile.org",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/originator-profile/originator-profile.git",
    "directory": "packages/wordpress"
  },
  "type": "module",
  "scripts": {
    "e2e": "pnpm --workspace-root exec turbo run build --filter=@originator-profile/sign --filter=@originator-profile/verify && playwright test",
    "e2e:update": "pnpm run e2e --update-snapshots",
    "version": "shx sed -i 's/(?<= Version: *)[^ ]*$/'${npm_package_version}/ ca-manager.php && git add ca-manager.php"
  },
  "devDependencies": {
    "@originator-profile/cryptography": "workspace:*",
    "@originator-profile/model": "workspace:*",
    "@originator-profile/sign": "workspace:*",
    "@originator-profile/verify": "workspace:*",
    "@playwright/test": "1.59.1",
    "@wordpress/e2e-test-utils-playwright": "1.45.0",
    "jsdom": "29.0.2",
    "shx": "0.4.0"
  }
}
