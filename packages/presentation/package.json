{
  "name": "@originator-profile/presentation",
  "version": "0.5.0-beta.0",
  "license": "Apache-2.0",
  "homepage": "https://docs.originator-profile.org",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/originator-profile/originator-profile.git",
    "directory": "packages/presentation"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "exports": {
    "require": {
      "types": "./dist/index.d.cts",
      "default": "./dist/index.cjs"
    },
    "import": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "pkgroll --clean-dist --target=node20",
    "test": "vitest run",
    "lint": "eslint --fix .",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@originator-profile/model": "workspace:*"
  },
  "devDependencies": {
    "@originator-profile/tsconfig": "workspace:*",
    "eslint": "^9.39.2",
    "eslint-config-originator-profile": "workspace:*",
    "happy-dom": "^20.4.0",
    "msw": "^2.12.7",
    "pkgroll": "^2.22.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  }
}
