  "scripts": {
    "build": "run-p build:*",
    "build:chromium": "dotenv -e ../registry/.env.development.auth node esbuild.mjs",
    "build:firefox": "dotenv -e ../registry/.env.development.auth node esbuild.mjs -- -t firefox-desktop",
    "dev": "dotenv -e ../registry/.env.development.auth node esbuild.mjs -- --mode=development",
    "dev:firefox": "dotenv -e ../registry/.env.development.auth node esbuild.mjs -- --mode=development -t firefox-desktop",
    "lint": "eslint --fix .",
    "e2e": "NODE_OPTIONS='--conditions=typescript' LC_ALL=ja_JP.UTF-8 dotenv -e ../registry/.env.development playwright test",
    "test": "vitest run",
    "type-check": "tsc --noEmit"
  }
