{
  "name": "@originator-profile/web-ext",
  "description": "Profile Web Extension",
  "version": "0.2.0-beta.3",
  "private": true,
  "type": "module",
  "bugs": {
    "url": "https://github.com/originator-profile/profile/issues"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@headlessui/react": "2.2.2",
