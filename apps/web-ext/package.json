    "@playwright/test": "^1.52.0",
    "@tailwindcss/postcss": "^4.1.7",
    "@types/chrome": "^0.0.326",
    "@types/esbuild-copy-static-files": "^0.1.4",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.3",
    "@uiw/react-json-view": "2.0.0-alpha.32",
    "@webext-core/messaging": "^2.2.0",
    "chokidar": "^4.0.3",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
