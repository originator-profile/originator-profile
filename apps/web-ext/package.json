{
  "name": "@originator-profile/web-ext",
  "description": "Profile Web Extension",
  "version": "0.5.0-beta.0",
  "license": "Apache-2.0",
  "private": true,
  "homepage": "https://docs.originator-profile.org",
  "bugs": "https://github.com/originator-profile/originator-profile/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/originator-profile/originator-profile.git",
    "directory": "apps/web-ext"
  },
  "type": "module",
  "dependencies": {
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.6",
    "@iconify/react": "^6.0.2",
    "@originator-profile/core": "workspace:*",
    "@originator-profile/cryptography": "workspace:*",
    "@originator-profile/model": "workspace:*",
    "@originator-profile/presentation": "workspace:*",
    "@originator-profile/securing-mechanism": "workspace:*",
    "@originator-profile/tsconfig": "workspace:*",
    "@originator-profile/ui": "workspace:*",
    "@originator-profile/verify": "workspace:*",
    "@playwright/test": "^1.58.0",
    "@tailwindcss/postcss": "^4.1.18",
    "@types/chrome": "^0.1.36",
    "@types/esbuild-copy-static-files": "^0.1.4",
    "@types/react": "^19.2.10",
    "@types/react-dom": "^19.2.3",
    "@uiw/react-json-view": "2.0.0-alpha.41",
    "@webext-core/messaging": "^2.3.0",
    "astro": "^5.17.0",
    "chokidar": "^5.0.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "dotenv": "^17.2.3",
    "esbuild": "^0.27.2",
    "esbuild-copy-static-files": "^0.1.0",
    "eslint": "^9.39.2",
    "eslint-config-originator-profile": "workspace:*",
    "globals": "^17.2.0",
    "happy-dom": "^20.4.0",
    "just-flush": "^2.3.0",
    "npm-run-all2": "8.0.4",
    "playwright": "^1.58.0",
    "postcss": "^8.5.6",
    "postcss-load-config": "^6.0.1",
    "react-router": "^7.13.0",
    "react-use": "^17.6.0",
    "simple-tree-utils": "^3.3.0",
    "swr": "^2.3.8",
    "tailwind-config-originator-profile": "workspace:*",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "^4.1.18",
    "typed-url-params": "^1.0.1",
    "typescript": "^5.9.3",
    "use-debounce": "^10.1.0",
    "vitest": "^4.0.18",
    "web-ext": "^9.2.0"
  },
  "keywords": [
    "webextension"
  ],
  "scripts": {
    "build": "pnpm /^build:.*/",
    "build:chromium": "node esbuild.mjs",
    "build:firefox": "node esbuild.mjs -t firefox-desktop",
    "dev": "NODE_ENV=development pnpm build:chromium",
    "dev:firefox": "NODE_ENV=development pnpm build:firefox",
    "e2e": "NODE_ENV=testing run-s build:chromium e2e:en e2e:ja",
    "e2e:update": "NODE_ENV=testing run-s build:chromium e2e:en:update e2e:ja:update",
    "e2e:ja": "LC_ALL=ja_JP.UTF-8 playwright test --project=ja",
    "e2e:ja:update": "LC_ALL=ja_JP.UTF-8 playwright test --project=ja --update-snapshots",
    "e2e:en": "LC_ALL=en_US.UTF-8 playwright test --project=en",
    "e2e:en:update": "LC_ALL=en_US.UTF-8 playwright test --project=en --update-snapshots",
    "test": "vitest run",
    "lint": "eslint --fix .",
    "type-check": "tsc --noEmit"
  }
}
