{
  "name": "@originator-profile/inspector",
  "description": "OP Inspector is a dev debug tool to verify Originator Profile info, proving authenticity and credibility of information originators.",
  "version": "0.7.0-beta.1",
  "license": "Apache-2.0",
  "private": true,
  "homepage": "https://docs.originator-profile.org",
  "bugs": "https://github.com/originator-profile/originator-profile/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/originator-profile/originator-profile.git",
    "directory": "apps/inspector"
  },
  "type": "module",
  "dependencies": {
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.8",
    "@iconify/react": "6.0.2",
    "@originator-profile/core": "workspace:*",
    "@originator-profile/cryptography": "workspace:*",
    "@originator-profile/model": "workspace:*",
    "@originator-profile/presentation": "workspace:*",
    "@originator-profile/securing-mechanism": "workspace:*",
    "@originator-profile/tsconfig": "workspace:*",
    "@originator-profile/ui": "workspace:*",
    "@originator-profile/verify": "workspace:*",
    "@playwright/test": "1.59.1",
    "@tailwindcss/postcss": "4.2.2",
    "@types/chrome": "0.1.40",
    "@types/esbuild-copy-static-files": "0.1.4",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@uiw/react-json-view": "2.0.0-alpha.42",
    "@webext-core/messaging": "2.3.0",
    "astro": "6.4.6",
    "chokidar": "5.0.0",
    "date-fns": "4.1.0",
    "dotenv": "17.4.2",
    "esbuild": "0.27.7",
    "esbuild-copy-static-files": "0.1.0",
    "globals": "17.5.0",
    "happy-dom": "20.8.9",
    "just-flush": "2.3.0",
    "just-safe-get": "4.2.0",
    "npm-run-all2": "8.0.4",
    "oxlint": "^1.73.0",
    "oxlint-tsgolint": "^0.24.0",
    "playwright": "1.59.1",
    "postcss": "8.5.12",
    "postcss-load-config": "6.0.1",
    "react-router": "7.15.1",
    "react-use": "17.6.0",
    "simple-tree-utils": "3.3.0",
    "swr": "2.4.1",
    "tailwind-config-originator-profile": "workspace:*",
    "tailwind-merge": "3.5.0",
    "tailwindcss": "4.2.2",
    "typed-url-params": "1.0.1",
    "use-debounce": "10.1.1",
    "vitest": "4.1.4",
    "web-ext": "10.1.0",
    "wxt": "0.20.27"
  },
  "keywords": [
    "webextension"
  ],
  "scripts": {
    "build": "pnpm /^build:.*/",
    "build:chromium": "node esbuild.ts",
    "build:firefox": "node esbuild.ts -t firefox-desktop",
    "dev": "NODE_ENV=development pnpm build:chromium",
    "dev:firefox": "NODE_ENV=development pnpm build:firefox",
    "e2e": "NODE_ENV=testing run-s build:chromium e2e:en e2e:ja",
    "e2e:update": "NODE_ENV=testing run-s build:chromium e2e:en:update e2e:ja:update",
    "e2e:ja": "LC_ALL=ja_JP.UTF-8 playwright test --project=ja",
    "e2e:ja:update": "LC_ALL=ja_JP.UTF-8 playwright test --project=ja --update-snapshots",
    "e2e:en": "LC_ALL=en_US.UTF-8 playwright test --project=en",
    "e2e:en:update": "LC_ALL=en_US.UTF-8 playwright test --project=en --update-snapshots",
    "test": "vitest run",
    "lint": "oxlint --fix .",
    "build-for-amo": "run-s build:firefox presubmit",
    "presubmit": "git -C ../.. archive --format=zip --output=apps/inspector/web-ext-artifacts/sources.zip HEAD",
    "submit": "wxt submit --chrome-zip web-ext-artifacts/op_inspector-chromium-*.zip --firefox-zip web-ext-artifacts/op_inspector-firefox-desktop-*.zip --firefox-sources-zip web-ext-artifacts/sources.zip"
  }
}
